    "frontend": "npm --prefix frontend run dev",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "keywords": [
    "ai",
    "work-continuity",
    "context-transfer",
    "meeting-intelligence",
    "gemini",
    "knowledge-management"
