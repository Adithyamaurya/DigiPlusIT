{
  "name": "contextflow",
  "version": "1.0.0",
  "description": "ContextFlow - AI-Powered Knowledge & Task Management Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "server": "npm --prefix backend run start",
