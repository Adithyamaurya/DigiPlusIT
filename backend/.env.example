# WorkTrace Environment Configuration Example
# Copy this file to .env and replace placeholders with your credentials

# Server
PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# Database (Supabase PostgreSQL)
# Leave blank to automatically use local persistent PostgreSQL (PGlite)
DATABASE_URL=
DB_SSL=false

# Google Gemini AI Integration
# Required for live AI Meeting Recaps, Catch-Up Briefs, and Handoff generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
